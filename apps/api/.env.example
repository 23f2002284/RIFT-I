# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Port 6543 = Transaction Pooler (use this for FastAPI / async apps)
# Port 5432 = Direct connection (use ONLY for migrations: alembic upgrade head)
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler -> URI
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Supabase Client SDK ───────────────────────────────────────────────────────
# Get all 3 from: Supabase Dashboard -> Project Settings -> API

# Your Supabase project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (formerly "anon key") — safe to use in client-side code
# Starts with: sb_publishable_...  (older projects: eyJ...)
# ✅ Respects Row Level Security (RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (formerly "service_role key") — BACKEND ONLY. Never expose publicly!
# Starts with: sb_secret_...  (older projects: eyJ...)
# ❌ Bypasses Row Level Security (RLS) — full database access
SUPABASE_SECRET_KEY=sb_secret_...

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=<a-long-random-secret-string-for-jwt-signing>
